# History
# 
# bengsig   7-jan-2025 - extra sleeps start at second run
# bengsig  23-dec-2025 - extra sleep before run in stead of after
# bengsig  15-dec-2025 - add --runperiod
# bengsig   2-dec-2025 - inform when extra sleep takes place
# bengsig   1-dec-2025 - --sleep-sequence option
# bengsig  10-oct-2023 - Smarter run file
# bengsig   4-oct-2023 - Longoptions, --sleep
# bengsig         2019 - Creation

. oltp-setup-env

options="Ggk:HaR:WK:S:s:r: -l runperiod:,sleep-sequence:,sleep:,help,graphs,qegraphs,preallocate,key:,runfile:,awrwait,awrkill:"
usage="$commandname [-H|--help] [-g|-G] [-a] [-k key] [-R file] [-W] [-K nn] [komment text ...]"

copyargs=''
help=no
sleepsequence=''
sleeplen=0
sleeptime=0
key=$RWLOLTP_NAME
runperiod=3590 # just under 1h

getopt -n $commandname -Q -o $options -- "$@" || exit 1
eval set -- $(getopt -n $commandname -o $options -- "$@")

while test $1 != '--'
do
  case $1 in 
    --awrkill|-K|-R) copyargs="$copyargs $1 $2"; shift; shift;
        ;;
    --runperiod|-r) runperiod="$2"; shift; shift;
        ;;
    --sleep-sequence|-S) sleepsequence="$2"; shift; shift;
        ;;
    --sleep|-s) sleeptime=$2; shift; shift;
        ;;
    --key|-k) key=$2; shift; shift;
        ;;
    --awrwait|--graphs|--qegraphs|--preallocate|-W|-a|-g|-G) copyargs="$copyargs $1"; shift;
        ;;
    --help|-H ) help=yes; shift;
        ;;
    esac;
done
shift
komment="$*"

if test x$help = xyes
then
echo "$usage"
cat <<END
-H --help        : show this help
-k --key key     : set the value of the key to be used in repository, default $RWLOLTP_NAME
-g --graphs      : show running graphs - requires X windows
-G --qegraphs    : show alternative running graphs - requires X windows
-a --preallocate : pre allocate partitions - use with great care
-R --runfile fil : Set non-default file to execute, default run.rwl
-r --runperiod N : make each run N seconds rather just under 1h
-s --sleep sec   : sleep this many seconds after each run
-S --sleep-sequence 'sec1 sec2 ...'
                 : set a sequence of seconds to sleep
END
exit 0
fi

runfile=$RWLOLTP_NAME.run

# check sleeptime is valid
if [[ $sleeptime =~ ^[0-9]+$ ]]
then
  :
else
  echo expecting a non negative integer in stead of $sleeptime, ignoring 1>&2
  sleeptime=0
fi
# prepare a sequence of sleep times
declare -a sleepseq
for slp in $sleepsequence
do
  if [[ $slp =~ ^[0-9]+$ ]]
  then
    sleepseq[$sleeplen]=$slp
    sleeplen=$(expr $sleeplen + 1)
  else
    echo expecting a non negative integer in stead of $slp, ignoring 1>&2
  fi
done
if test $sleeplen -gt 0
then
  sleepix=$(expr $sleeplen - 1)
else
  sleepix=0
fi


# These two files will contain the time (from date +%s) at which the next
# side 2 run should start and the arguments to start it.
side2time=$RWLOLTP_NAME.2time
side2args=$RWLOLTP_NAME.2args

if test -f $side2time
then
  echo oltpforever appears to be running 1>&2
  echo verify and possibly remove $side2time
  exit 2
fi


echo '# Workload started on' `date` from `tty` on `hostname` > $runfile

# delay in starting forever2.sh
separation=$(expr '(' $runperiod + $sleeptime + 100 ')' / 2)

# for debug use these:
#runperiod=295
#separation=`expr 150 + $sleeptime / 2`

sleepinfo=$(mktemp)

trap "rm -f $sleepinfo $runfile $side2time $side2args; exit 1" sigint
echo '# Remove this file to stop workload after at most' $runperiod seconds. >> $runfile
echo '# The process id of oltpforever starting this workload is' $$ >> $runfile
echo '# You may want to execute one of these commands:' >> $runfile
echo 'echo OLTPFOREVER IS RUNNING HERE >' `tty` >> $runfile
echo 'ps -fp'$$ -wwww >> $runfile


# run until the file is removed
firstrun=yes
while test -f $runfile
do
  # this is just to get forever_proccount:
  eval `rwloadsim -q parameters2shell.rwl`

  if test -x foreverextra-$RWLOLTP_NAME.sh
  then
    extrascript="-x ./foreverextra-$RWLOLTP_NAME.sh"
  else
    extrascript=''
  fi

  timenow=`date '+%s'`
  echo `expr $timenow + $separation` > $side2time
  echo "-k $key $extrascript $copyargs -r $runperiod -n $forever_proccount $komment" > $side2args

  if test $sleeplen -gt 0
  then
    extrasleep=${sleepseq[$sleepix]}
    sleepix=$(expr $sleepix + 1)
    if test $sleepix -ge $sleeplen
    then
      sleepix=0
    fi
  else
    extrasleep=0
  fi
  totalsleep=$(expr $sleeptime + $extrasleep)
  if test $totalsleep -gt 0 -a $firstrun = no
  then
    echo sleeping for $totalsleep seconds before starting run
    sleep $totalsleep
    echo oltpforever was sleeping $totalsleep seconds before the run was started > $sleepinfo
    oltprun -k $key -o $sleepinfo $extrascript $copyargs -r $runperiod -n $forever_proccount $komment
  else
    oltprun -k $key $extrascript $copyargs -r $runperiod -n $forever_proccount $komment
  fi
  firstrun=no
done
rm -f $runfile $side2time $side2args
