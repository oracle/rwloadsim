# bengsig         2019 - Creation

# Truncate old partitions in orders and order_items

$include:"parameters.rwl"
$include:"oe_user.rwl"
$if xc_enabled $then
 $include:"results.rwl"
 $include:"xc_implementation.rwl"
$endif


$oraerror:stop

procedure trunctables() nostatistics

  alter table order_items drop partition for (0)
  /

  truncate table orders_dummy
  /

  alter table orders
  exchange partition for (0)
  with table orders_dummy
  including indexes
  /

  alter table orders
  drop partition for (0)
  /

end trunctables;

private integer pcount := 99999;

private sql get_pcount  /* runtrunc sql 1 */
  select count(*) pcount from user_tab_partitions where table_name = 'ORDERS';
  define sql;
end;

$if use_json_orders $then
private integer pcount_json := 99999;

private sql get_pcount_json  /* runtrunc sql 2 */
  select count(*) pcount_json from user_tab_partitions where table_name = 'ORDERS_JSON';
  define sql;
end;


procedure trunctables2() nostatistics

  alter table orders_json
  exchange partition for (0)
  with table orders_json_dummy
  including indexes
  /

  alter table orders_json
  drop partition for (0)
  /

end trunctables2;

$endif


run

$if xc_enabled $then
  threads 1 at rwloadsim
    for every xc_refresh stop runperiod loop
      xc_read(0);
      if xc_stopnow=1 or xc_stopnow=2 then break; end if;
    end loop;
  end threads;
$endif

  threads 1 at rwl_oe_pool


    for stop runperiod / 2 - 10 loop
      get_pcount;
      if pcount<=25 $if xc_enabled $then or xc_stopnow=1 or xc_stopnow=2 $endif then
        return;
      end if;
      printline "truncate oldest partitions in orders and order_items", pcount, runseconds();
      fflush stdout;
      trunctables();

      $if use_json_orders $then
        get_pcount_json;
        if pcount_json <= 25  then
          return;
        end if;
        printline "truncate oldest partitions in orders_json ", pcount_json, runseconds();
        fflush stdout;
        trunctables2();
      $endif

    end loop;

  end threads;
end run;

get_pcount at rwl_oe_pool;
printline "No more partition truncate to do", pcount, runseconds();

$if use_json_orders $then
  get_pcount_json at rwl_oe_pool;
  printline "No more partition truncate to do for orders_json ", pcount_json, runseconds();
$endif

