# Generate graphs for an entire day
# This is typically used after having executed
# oltpforever for a long time
#
# Changes
#
# bengsig  23-dec-2025 - Save runperiod in nattr3
# bengsig   5-aug-2025 - Add heading to outliers.html
# bengsig  25-jun-2025 - Add initial table of contents with links
# bengsig  20-jun-2025 - Add daily memory plot
# bengsig   4-feb-2025 - Fix ORA-00936 when no runs on day
# bengsig   4-feb-2025 - Use proper term "SLA" in stead of outlier
# bengsig  27-jan-2025 - rwlrunkey sql inst list is full run
# bengsig  23-jan-2025 - Improve performance using literals
# bengsig  22-jan-2025 - Add brief outliers report
# bengsig         2019 - Creation

# include for test $sqllogging:file:"dayrap.txt"
$ampersand:on

$include:"parameters.rwl"
$if $# != 2 $then
  writeline stderr, "please provide key and date (YYYY.MM.DD)";
$else
$include:"results.rwl"
$mute:50 # missing array

file out1file, out2file;

string myfulldate, mydate, mydateb, mydatee, rdate, komment, key, mykey;
string(10000) runnolist;
integer runno;

integer olines := 0;

integer i1, i2, i3, i4, i5, i6, i7, i8;

execute at rwloadsim
    mykey := $1; mydate := $2;
      
    out1file := awrdirectory "/" mydate "." mykey ".html";

    string vname;
    integer out50, out90, out95, out98, outcount := 0;
    integer under10, btw_10_30, btw_31_100, above100, still;

    select to_char(to_date(:mydate,'YYYY.MM.DD'),'FMDay, Month/DD YYYY') myfulldate from dual;

    # genrate mydateb and mydatee using sql to prevent injection
    select to_char(to_date(:mydate || '_00:00:00','YYYY.MM.DD_HH24:MI:SS')
      ,'YYYY.MM.DD_HH24:MI:SS') mydateb from dual;
    select to_char(to_date(:mydate || '_23:59:59','YYYY.MM.DD_HH24:MI:SS')
      ,'YYYY.MM.DD_HH24:MI:SS') mydatee from dual;

    # generate runnolist to be an inlist of all relevant runnumbers for the day
    # this prevents repeating the following as an awful join that makes
    # the optimizer choose bad sort/merge joins with full table access
    runnolist := "(-1";
    for 
      select runnumber runno
      from rwlrun w
      where w.key = :mykey
      and w.hostname = :hostname
      and w.rdate between to_date('&mydateb.','YYYY.MM.DD_HH24:MI:SS')
		and     to_date('&mydatee.','YYYY.MM.DD_HH24:MI:SS')
      /
    loop
      sprintf|| runnolist, ",%d", runno;
    end loop;
    runnolist ||= ")";

    # This sql is used a few times, so to prevent
    # typing it with ampersand multiple time
    # we declare it as dynamic and include
    # the runnolist in the text
    sql rwlrunkey
      define 1 runno, 2 komment, 3 key, 4 rdate;
      define 5 i1, 6 i2, 7 i3, 8 i4, 9 i5, 10 i6, 11 i7, 12 i8;
    end;
    modify sql rwlrunkey for
      "select w.runnumber, w.komment, w.key
      , to_char(w.rdate, 'Dy YYYY.MM.DD_HH24:MI:SS')
      , s.i1
      , s.i2
      , s.i3
      , s.i4
      , s.i5
      , s.i6
      , s.i7
      , s.i8
      from rwlrun w
      join
      ( " # The two " " here are just to make it look nice in vim
	"select runnumber
	, sum(val1) i1
	, sum(val2) i2
	, sum(val3) i3
	, sum(val4) i4
	, sum(val5) i5
	, sum(val6) i6
	, sum(val7) i7
	, sum(val8) i8
	from sysres 
	where resname = 'INSTCNT'
	group by runnumber
      ) s
      on w.runnumber = s.runnumber
      where w.runnumber in " runnolist "
      order by w.rdate";

    string(4000) oerlisting;

    sql oerlist
      select listagg(oer||'('||count(*)||')',', ')
      from oerstats
      where runnumber=:1
      group by oer
      /
      define 1 oerlisting;
      bind 1 runno;
    end;

    integer total := 0;
    integer cnt;
    string(200) txt;

    sql seloer
      select
      count(*)
      , any_value(oertxt)
      from oerstats
      where runnumber=:1
      group by oer
      order by oer
      /
      bind 1 runno;
      define 1 cnt, 2 txt;
      array 100;
    end;

    string prevdate, nextdate;

    sql selpn
      select
        to_char(to_date(:1,'YYYY.MM.DD')-1,'YYYY.MM.DD')
      , to_char(to_date(:1,'YYYY.MM.DD')+1,'YYYY.MM.DD')
      from dual;
      bind 1 mydate;
      define 1 prevdate, 2 nextdate;
    end;

    selpn;

    # print the header
    writeline out1file, "<h1 id=\"daytop\">Throughput for all runs on "  mydate " for " rwl_heading " </h1>";
    writeline out1file, " <a href=\"" prevdate "." mykey ".html\">previous day</a>";
    writeline out1file, " <a href=\"" nextdate "." mykey ".html\">next day</a>";
    writeline out1file, " <a href=\"" rwl_daily_html "\">list of all days</a>";
    writeline out1file, " <a href=\"" mydate "_" mykey "_files/outliers.html\">brief daily summary</a> ";
    writeline out1file, "<h2>Table of contents</h2>
    <a href=\"#slaviolations\">SLA violations</a><br>
    <a href=\"#lowthru\">Runs with low throughput or complete standstill</a><br>
    <a href=\"#errors\">Errors during the day</a><br>
    <a href=\"#percentiles\">Execution time percentiles</a><br>
    <a href=\"#dayruns\">Brief list of all runs</a><br>
    <a href=\"#allruns\">Full list of all runs</a><br>
    <a href=\"#memory\">Database buffer cache, shared pool, PGA</a><br>";

    string(1000) hdir;
    hdir := awrdirectory "/" mydate "_" mykey "_files/";
    if not access(hdir, "wd") then
      null system("mkdir -p " hdir);
    end if;

    # Check for outliers

    string(32000) html, stillhtml;

    html  :="<h2 id=\"slaviolations\">SLA violations</h2>\nCount of runs with SLA violations:<br><br>\n<table>\n";

    html ||="<tr> <th>50%</th> <th>90%</th> <th>95%</th> <th>98%</th> <th align='left'>Transaction type</th></tr>\n";

    for
      select /*+monitor gather_plan_statistics*/ ol.out50
      , ol.out90
      , ol.out95
      , ol.out98
      , ol.vname
      from
      (
      select 
        sum (case when p.pct50 > b.lim50 then 1 else 0 end) out50
      , sum (case when p.pct90 > b.lim90 then 1 else 0 end) out90
      , sum (case when p.pct95 > b.lim95 then 1 else 0 end) out95
      , sum (case when p.pct98 > b.lim98 then 1 else 0 end) out98
      , b.vname
      from
      percentiles_oltp p
      join oltp_outliers b
      on p.vname = b.vname
      where p.runnumber in &runnolist.
      and p.vname in
      ( 'complex_query'
      , 'make_order'
      , 'query_order'
      , 'search_products'
      , 'aw_transaction'
      )
      group by
        b.vname
      ) ol
      order by
        ol.vname
      /
    loop
      if out50 or out90 or out95 or out98 then
        html ||="<tr> <td align='right'>"||out50||"</td>"
             "<td align='right'>"||out90||"</td>"
             "<td align='right'>"||out95||"</td>"
             "<td align='right'>"||out98||"</td>"
             "<td>"||vname||"</td></tr>\n";
        outcount += 1;
      end if;
    end loop;

    out2file := hdir "outliers.html";
    writeline out2file, "<h2>Brief daily summary for " rwl_heading " on " myfulldate "</a></h1>";
    if outcount then
      html ||= "</table><br>\n";
      writeline out2file, html;
      writeline out1file, html;
    else
      writeline out2file, "<h3>No SLA violations during " mydate " for " rwl_heading "</h3>\n";
      writeline out1file, "<h2 id=\"slaviolations\">No SLA violations during this day</h2>\n";
    end if;

    html  :="<h2 id=\"lowthru\">Runs having seconds with low throughput</h3>\n<table>\n";

    html ||="<tr> <th colspan=\"4\">Seconds range</th> <th align='left'>Transaction type</th></tr>\n";
    html ||="<tr> <th>&lt;10</th> <th>10-30</th> <th>30-100</th> <th>&gt;100</th> <th align='left'> </th></tr>\n";

    for 
      select x.vname
      , sum(case when x.toofew between 1 and 10 then 1 else 0 end) under10
      , sum(case when x.toofew between 10 and 30 then 1 else 0 end) btw_10_30
      , sum(case when x.toofew between 31 and 100 then 1 else 0 end) btw_31_100
      , sum(case when x.toofew > 100 then 1 else 0 end) above100
      from
      (
      select s.runnumber
      , s.vname
      --, avg(scount), min(scount), max(scount) 
      , sum ( case when
              s.scount < decode (s.vname
                    ,'aw_transaction', 125
                    ,'make_order', 40
                    ,'query_order', 150
                    ,'search_products', 2
                    ,'complex_query', 2
                    )
              then 1 else 0 end ) toofew
      from persec_a s
      where
        s.runnumber in &runnolist.
      and s.second between 10 and 3590
      and s.vname in
      ('aw_transaction'
      ,'make_order'
      ,'query_order'
      ,'search_products'
      ,'complex_query'
      )
      group  by s.runnumber, s.vname
      ) x
      group by x.vname
      order by x.vname
      /
    loop
      if under10 or btw_10_30 or btw_31_100 or above100 then
        html ||="<tr> <td align='right'>"||under10||"</td>"
             "<td align='right'>"||btw_10_30||"</td>"
             "<td align='right'>"||btw_31_100||"</td>"
             "<td align='right'>"||above100||"</td>"
             "<td>"||vname||"</td></tr>\n";
        outcount += 1;
      end if;
    end loop;

    integer sscount := 0;
    integer sssum := 0;
    stillhtml := "";
    for
      select s.runnumber runno
      , nvl(any_value(r.nattr3)-10,3581) - count(s.second) still
      from
      ( select runnumber, second
        from persec
        where second between 10 and 3590
        and vname in
        ('aw_transaction'
        ,'make_order'
        ,'query_order'
        ,'search_products'
        ,'complex_query'
        )
        and scount>0
        group by runnumber, second
      ) s
      join rwlrun r
      on r.runnumber = s.runnumber
      where
      s.runnumber in &runnolist.
      having count(s.second) < nvl(any_value(r.nattr3)-10,3581)
      and min(r.rdate) < sysdate - 1/24
      group  by s.runnumber
      order  by s.runnumber
    /
    loop
      if sscount then
        stillhtml ||= ", <a href=\"#" runno "\">" still "</a>";
      else
        stillhtml :=    "<a href=\"#" runno "\">" still "</a>";
      end if;
      sscount += 1;
      sssum += still;
    end loop;

    if outcount or sscount then
      html ||= "</table><br>\n";
      writeline out2file, html;
      writeline out1file, html;
      if sscount then
        if sssum >= 60 then
          writeline out2file, "<p style=\"color:red;\"><b>" sscount " runs with complete standstill for a total of " sssum
            " seconds.</b></p>\n";
        else
          writeline out2file, "<b>" sscount " runs with complete standstill for a total of " sssum
            " seconds.</b>\n";
        end if;
        writeline out1file, "<b>" sscount " runs with complete standstill (counts link to actual run): " stillhtml "</b>\n";
      else
        writeline out1file, "No runs with complete standstill\n";
        writeline out2file, "No runs with complete standstill\n";
      end if;
    else
      writeline out2file, "<h2>No seconds with too low throughput during " mydate " for " rwl_heading "</h2>\n";
      writeline out1file, "<h2 id=\"lowthru\">No seconds with too low throughput this day</h2>\n";
    end if;

    # Check/list errors

    string oertxt, oerinst;
    integer oercnt, oernum;

    # Output errors today, if any
    string(100000) errhtml;
    integer haserror := 0;
    integer accerror := 0;

    errhtml :="<tr> <th>Count</th> <th>Instance</th> <th>Error</th> <th align='left'>Error text</th></tr>\n";

    for 
      select o.oer oernum
      , any_value(oertxt) oertxt
      , count(*) oercnt
      , o.oerinst
      from oerstats o
      where o.runnumber in &runnolist.
      group by o.oer, o.oerinst
      order by o.oer, o.oerinst
      /
    loop
      errhtml ||="<tr> <td align='right'>"  oercnt "</td>"
	     "<td>" oerinst "</td>"
	     "<td align='right'>" substrb(oertxt,5,5) "</td>"
	     "<td>" oertxt "</td></tr>\n";
      haserror += 1;
      if     oernum = 1013
          or oernum = 1400
          or oernum = 60
          or oernum = 20019
          or oernum = 20020
          or oernum = 20999
      then
        accerror += 1;
      end if;
    end loop;

    if haserror then
      writeline out1file, "<h2 id=\"errors\">Errors during " mydate " for " rwl_heading "</h2>\n<table>" ;
      writeline out1file, errhtml;
      writeline out1file, "</table><br>";
      if haserror > accerror then
        writeline out2file, "<h3 style=\"color:red;\">Errors</h3>\n<table>\n";
      else
        writeline out2file, "<h3>Errors</h3>\n<table>\n";
      end if;
      writeline out2file, errhtml;
      writeline out2file, "</table><br>";
    else
      writeline out2file, "<h3>No errors</h3>\n";
      writeline out1file, "<h2 id=\"errors\">No errors</h3>\n";
    end if;

    # Output the percentile graphs
    writeline out1file, "<h2 id=\"percentiles\"> Execution time percentiles</h2>";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/make_order.svg\">";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/search_products.svg\"><br>";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/query_order.svg\">";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/complex_query.svg\"><br>";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/aw_transaction.svg\"><br>";
    writeline out1file, "<br>Png versions: <a href=\"" mydate "_" mykey "_files/make_order.png\">make_order.png</a> ";
    writeline out1file, "<a href=\"" mydate "_" mykey "_files/search_products.png\">search_products.png</a> ";
    writeline out1file, "<a href=\"" mydate "_" mykey "_files/query_order.png\">query_order.png</a> ";
    writeline out1file, "<a href=\"" mydate "_" mykey "_files/complex_query.png\">complex_query.png</a>";
    writeline out1file, "<a href=\"" mydate "_" mykey "_files/complex_query.png\">aw_transaction.png</a><br>";

    writeline out1file, "<h2 id=\"dayruns\">Runs during this day</h2>Instance(s) used at the begin of each run, and errors (if any) are shown<ul>";
    # list all runs with links
    for rwlrunkey loop
      write out1file, "<li><a href=\"#" runno "\">", rdate, "</a>, inst:";
      if i1 then write out1file, " 1"; end if;
      if i2 then write out1file, " 2"; end if;
      if i3 then write out1file, " 3"; end if;
      if i4 then write out1file, " 4"; end if;
      if i5 then write out1file, " 5"; end if;
      if i6 then write out1file, " 6"; end if;
      if i7 then write out1file, " 7"; end if;
      if i8 then write out1file, " 8"; end if;
      oerlisting := "";
      oerlist;
      if oerlisting = "" then
        writeline out1file, "</li>";
      else
        writeline out1file, ", errors:", oerlisting, "</li>";
      end if;

    end loop;
    # and the real data
    string awd;
    writeline out1file, "</ul><h2 id=\"allruns\">All run data</h2>";
    for rwlrunkey loop
      if access(awrdirectory "/" runno, "d") then
        awd := runno;
      else
        awd := "r" runno/1000 "/" runno;
      end if;
      writeline out1file, "<h3 id=\"" runno "\">", runno, key, rdate, komment, "</h3>";
      writeline out1file, "<a href=\"" awd "/" runno "_awr.html\">awr report</a>";
      write     out1file, "instances "; 
      if i1 then write out1file, " 1"; end if;
      if i2 then write out1file, " 2"; end if;
      if i3 then write out1file, " 3"; end if;
      if i4 then write out1file, " 4"; end if;
      if i5 then write out1file, " 5"; end if;
      if i6 then write out1file, " 6"; end if;
      if i7 then write out1file, " 7"; end if;
      if i8 then write out1file, " 8"; end if;
      writeline out1file, "</a> <a href=\"" awd "\">all details</a>";
      writeline out1file, " <a href=\"#daytop\">top of current day</a>";
      writeline out1file, " <a href=\"#dayruns\">list for current day</a>";

      total := 0;
      for seloer loop
	if ! total then
	  writeline out1file, " - this run had errors:<table>";
	end if;
	total += 1;
	writeline out1file, "<tr><td>", cnt, "</td><td>", txt, "</td>";
      end loop;
      if total then
	writeline out1file, "</table>";
      else
	writeline out1file, "<br>";
      end if;
      writeline out1file, "<embed src=\"" awd "/" runno ".svg\"><br>";

      olines += 1;
    end loop;

    writeline out1file, "<h2 id=\"memory\">Memory areas through the day</h2>";
    writeline out1file, "<embed src=\"" mydate "_" mykey "_files/daymemory.svg\">";
    writeline out1file, "<br>Png version:<a href=\"" mydate "_" mykey "_files/daymemory.png\">daymemory.png</a><br><br>";
    writeline out1file, "<a href=\"" prevdate "." mykey ".html\">previous day</a>";
    writeline out1file, "<a href=\"" nextdate "." mykey ".html\">next day</a>";
    writeline out1file, " <a href=\"" rwl_daily_html "\">list of all days</a>";
    fprintf out2file, "<h3>Full report</h3>\nThe full report for %s on %s available at the following URL<br>\n<a href=\""
    , rwl_heading, myfulldate;
    write out2file, awr_url_prefix "/" mydate "." mykey ".html";
    fprintf out2file, "\">%s</a>.\n", awr_url_prefix "/" mydate "." mykey ".html";
    out1file := null;
    out2file := null;
    # remove the files if they have no real contents
    if olines then
      printline "Total " olines " runs found for key=" mykey ", date=" mydate ", hostname=" hostname;
    else
      printline mydate "." mykey ".html was not created";
      null system("rm " awrdirectory "/" mydate "." mykey ".html");
      null system("rm -rf " awrdirectory "/" mydate "." mykey "_files");
    end if;

end;
$endif
