# Generate data for the daily percentiles

# bengsig  20-jun-2025 - Add daily memory plot
# bengsig  12-feb-2025 - exit if results db not good
# bengsig  23-jan-2024 - use percentiles_oltp
# bengsig         2019 - Creation

$include:"parameters.rwl"

$if $# != 2 $then
    writeline stderr, "please provide key and date (YYYY.MM.DD) as arguments";
$else

$include:"results.rwl"

$if not defined(rwloadsim) $then
  writeline stderr, "Error: daydata.rwl could not connect to repository";
  exit 1;
$endif

$dformat:%.6f

string mykey, mydate;

file csv1, csv2, csv3, plt;

execute at rwloadsim
# generate the gnuplot files
    mykey := $1; mydate := $2;

    # Directories for csv and plot files plus output image files
    string(1000) hdir;
    hdir := awrdirectory "/" mydate "_" mykey "_files/";
    null system("mkdir -p " hdir);
    string(1000) rdir ;

    integer rno;
    double avgt, pct50, pct90, pct95, pct98, pct99, avgw;
    string lastvname := "", vname, rtim;

    sql getpct
      select p.vname
      , to_char(w.rdate,'YYYY.MM.DD.HH24:MI') rtim
      , avgt, pct50, pct90, pct95, pct98, pct99
      , w.runnumber
      , r.avgw
      from percentiles_oltp p join rwlrun w
      on p.runnumber = w.runnumber
      join runres_a r
      on r.runnumber = w.runnumber
      and r.vname = p.vname
      where w.key = :mykey
      and hostname = :hostname
      and w.rdate between to_date(:mydate||'_00:00:00','YYYY.MM.DD_HH24:MI:SS')
		  and     to_date(:mydate||'_23:59:59','YYYY.MM.DD_HH24:MI:SS')
      order by p.vname, w.rdate
      /
      bind ":mykey" mykey, ":mydate" mydate, ":hostname" hostname;
      define 1 vname, 2 rtim;
      define 3 avgt, 4 pct50, 5 pct90, 6 pct95, 7 pct98, 8 pct99;
      define 9 rno;
      define 10 avgw;
      array 100;
    end;

    csv1 >= "/dev/null"; # Just to make first close below work

    for getpct loop
      if rdir = "" then
        # we reuse the first runnumber directory to save our csv and plot files
	# such that we avoid cluttering the already massive results directory
	rdir := resultsdir "/r" rno/1000 "/" rno "/";
	if !access(rdir, "wd") then
	  null system("mkdir -p " rdir);
	end if;
      end if;

      if vname != lastvname then
	csv1 := null;
        # There is a new vname
	if lastvname != "" then
	  # Plot the previous
	  null system("gnuplot " rdir lastvname ".plot");
	end if;

	lastvname := vname;
	csv1 >= rdir vname ".csv";
	writeline csv1,"# yyyy.mm.dd.hh24mi;avgt;pct50;pct90;pct98;pct99;avgw";

	plt >= rdir vname ".plot";
	writeline plt,"set xdata time";
	writeline plt,"set timefmt '%Y.%m.%d.%H:%M'";
	writeline plt,"set format x '%H:%M'";
	writeline plt,"set xrange ['" mydate ".00:00':'" mydate ".23:55']";
	writeline plt,"set datafile separator ';'";
	writeline plt,"set logscale y";
	writeline plt,"set key bmargin invert horizontal";
	if vname != "ship_many_orders" then
	  writeline plt,"set yrange [0.002:2.0]";
	end if;
	writeline plt,"set title '" vname " percentiles through " mydate "'";
	writeline plt,"set ylabel 'execution time in s'";
	writeline plt,"set xtics nomirror rotate by -90 scale 0 offset -1";
	writeline plt,"set ytics out";
	writeline plt,"set style fill solid noborder";
	if gnuplotjs != "" then
	  writeline plt,"set terminal svg size 480,360 mouse jsdir '" gnuplotjs "'";
	else
	  writeline plt,"set terminal svg size 480,360";
	end;
	writeline plt,"set output '" hdir "/" vname ".svg'";
	write     plt,"plot '" rdir vname ".csv' using 1:7 with boxes    title '  99%' lc rgb 'red'";
	write     plt,",    '" rdir vname ".csv' using 1:6 with boxes    title '  98%' lc rgb 'blue'";
	write     plt,",    '" rdir vname ".csv' using 1:5 with boxes    title '  95%' lc rgb 'web-blue'";
	write     plt,",    '" rdir vname ".csv' using 1:4 with boxes    title '  90%' lc rgb 'light-blue'";
	write     plt,",    '" rdir vname ".csv' using 1:3 with boxes    title '  50%' lc rgb 'pink'";
	writeline plt,",    '" rdir vname ".csv' using 1:8 with impulses title ' avgw' lw 2 lc rgb 'light-green'";
	writeline plt,"set terminal png";
	writeline plt,"set output '" hdir "/" vname ".png'";
	writeline plt,"replot" ;
	plt := null;
      end if;
      writeline csv1,rtim ";" avgt ";" pct50 ";" pct90 ";" pct95 ";" pct98 ";" pct99 ";" avgw;
    end loop;
    csv1 := null;

    # plot the last if anything was done
    if rdir != "" then
      null system("gnuplot " rdir   lastvname   ".plot");
    end if;

    # now deal with memory

    double val1, val2, val3, val4, val5, val6, val7, val8;
    string resname, mtim;

    # create the csv files

    csv1 >= rdir "daybcache.csv";
    csv2 >= rdir "daysharedp.csv";
    csv3 >= rdir "daypga.csv";

    for
      select to_char(w.rdate + s.second/60/60/24,'YYYY.MM.DD.HH24:MI:SS') mtim
      , s.resname
      -- the negative values prevent gnuplot
      -- from showing anything
      , nvl(s.val1,-1e4)/1024 val1
      , nvl(s.val2,-1e4)/1024 val2
      , nvl(s.val3,-1e4)/1024 val3
      , nvl(s.val4,-1e4)/1024 val4
      , nvl(s.val5,-1e4)/1024 val5
      , nvl(s.val6,-1e4)/1024 val6
      , nvl(s.val7,-1e4)/1024 val7
      , nvl(s.val8,-1e4)/1024 val8
      from rwlrun w
      join sysres s
      on w.runnumber = s.runnumber
      and w.key = :mykey
      and w.hostname = :hostname
      and w.rdate between to_date(:mydate||'_00:00:00','YYYY.MM.DD_HH24:MI:SS')-1/24
		  and     to_date(:mydate||'_23:59:59','YYYY.MM.DD_HH24:MI:SS')+1/24
      and resname in ('BCACHE','SHAREDP', 'PGA')
      order by w.rdate + s.second/60/60/24, resname
      /
    loop
      if resname = "BCACHE" then
	fprintf csv1, "%s %.3f %.3f %.3f %.3f %.3f %.3f %.3f %.3f\n"
	, mtim, val1, val2, val3, val4, val5, val6, val7, val8;
      elseif resname = "SHAREDP" then
	fprintf csv2, "%s %.3f %.3f %.3f %.3f %.3f %.3f %.3f %.3f\n"
	, mtim, val1, val2, val3, val4, val5, val6, val7, val8;
      else
	fprintf csv3, "%s %.3f %.3f %.3f %.3f %.3f %.3f %.3f %.3f\n"
	, mtim, val1, val2, val3, val4, val5, val6, val7, val8;
      end if;
    end loop;
    csv1 := null; csv2 := null; csv3 := null;

    csv1 >= rdir "daystart.csv";
    for 
      select to_char(w.rdate,'YYYY.MM.DD.HH24:MI:SS') mtim
      from rwlrun w
      where w.key = :mykey
      and w.hostname = :hostname
      and w.rdate between to_date(:mydate||'_00:00:00','YYYY.MM.DD_HH24:MI:SS')-1/24
		  and     to_date(:mydate||'_23:59:59','YYYY.MM.DD_HH24:MI:SS')+1/24
      order by w.rdate
      /
    loop
      writeline csv1, mtim;
    end loop;
    csv1 := null;

    # and the plot file
    plt >= rdir "daymemory.plot";
    fprintf   plt, "set title 'buffer cache, shared pool, pga (GB)'\n";
    writeline plt, "set xdata time";
    writeline plt, "set timefmt '%Y.%m.%d.%H:%M:%S'";
    writeline plt, "set format x '%H:%M'";
    writeline plt, "set terminal svg mouse standalone size 1024,480";
    fprintf   plt, "set output '%s/daymemory.svg\n", hdir;
    writeline plt, "set yrange [0.1:*]";
    writeline plt, "set ytics nomirror";
    writeline plt, "set key bmargin horizontal";
    writeline plt, "set logscale y";
    fprintf   plt, "set xrange ['%s.00:00:00':'%s.23:59:59']\n", mydate, mydate;

    string color;
    integer i := 0;
    for color := "magenta", "dark-red", "dark-green", "light-salmon", "dark-yellow", "light-green", "dark-orange", "skyblue" loop
      i += 1;
      if i=1 then
        write plt, "plot ";
      else
        write plt, ", ";
      end if;
      fprintf plt, "'%s/daybcache.csv' using 1:%d with lines lw 1 lc rgb '%s' axes x1y1 title 'bc %d' \\\n", rdir, i+1, color, i;
      if i then
	fprintf plt, ", '%s/daysharedp.csv' using 1:%d with linespoints pt 4 lw 1 ps 0.5 lc rgb '%s' axes x1y1 title 'sp %d' \\\n", rdir, i+1, color, i;
	fprintf plt, ", '%s/daypga.csv' using 1:%d with linespoints pt 3 lw 1 ps 0.5 lc rgb '%s' axes x1y1 title 'pga %d' \\\n", rdir, i+1, color, i;
      else
	fprintf plt, ", '%s/daysharedp.csv' using 1:%d with linespoints pt 4 lw 1 ps 0.5 lc rgb '%s' axes x1y1 notitle \\\n", rdir, i+1, color;
	fprintf plt, ", '%s/daypga.csv' using 1:%d with linespoints pt 3 lw 1 ps 0.5 lc rgb '%s' axes x1y1 notitle \\\n", rdir, i+1, color;
      end if;
    end loop;
    fprintf plt, ", '%s/daystart.csv' using 1:(0.1) with points pt 2 lw 1 ps 0.5 lc rgb 'black' axes x1y1 notitle\n", rdir;
    writeline plt, "set terminal png size 1024,480";
    fprintf   plt, "set output '%s/daymemory.png\n", hdir;
    writeline plt, "replot";
    plt := null;
    null system("gnuplot " rdir "daymemory.plot");
      
end execute;
$endif


