# bengsig  30-mar-2025 - Take out local/bucket copy code, use ocp in stead
# bengsig  17-mar-2025 - Add local copy of the dump file
# bengsig  11-mar-2025 - Better database list, use awr_exp if available
# bengsig  02-jan-2023 - Improve helptext and error on missing param
# bengsig  22-nov-2022 - Creation

# Dump awr data to a directory and potentially cloud bucket
$alwaysmute:206

# If we didn't connect, don't do anything
$if not defined(default database) $then
  writeline stderr, "Missing or incorrect -l option; use -h to get help";
  exit 1;
$endif

integer dbid;

integer begin_snap;

integer end_snap;

string(1000) directory := "DATA_PUMP_DIR";
string(1000) pathname, filename, logfile, localfile;
integer remove_file := 0;
integer use_extract := 0;

string(1000) credential, region, tenancy, bucket, object_uri;
              $userhelp:"Create an awr dump into a database directory"
              $userhelp:"-l usr/pwd@con            - required option providing database credentials"
       $useroption:dbid:"--dbid=<N>                - dbid of the database from which awr is dumped"
 $useroption:begin-snap:"--begin-snap=id           - first snapshot to export"
   $useroption:end-snap:"--end-snap=id             - last snapshot to export"
  $useroption:directory:"--directory=<directory>   - output to this directory, default DATA_PUMP_DIR"
   $useroption:filename:"--filename=<filename>     - use filename in stead of default (.dmp extension will be added)"
$userswitch:remove-file:"--remove-file             - if the file already exists, remove it before creating dump"
$userswitch:use-extract:"--use-extract             - don't attempt calling awr_exp before calling extract"
    $useroption:logfile:"--logfile=<filename>      - copy the logfile from data pump to the named local file"
              $userhelp:"After creating the awr dump, you can copy it locally or to a cloud bucket using ocp"

integer myroot;
integer mypdbid;
integer scount;
string ispluggable;
string instance_list;
string container;

select dbid myroot
, con_dbid mypdbid
, cdb ispluggable
from v$database
/

# If no dbid, list all available
if dbid is null then
  printf "       dbid con snap cnt instance list\n";
  printf "----------- --- -------- -------------\n";

  for
    select d.dbid
    , case when d.dbid = :myroot and :ispluggable = 'NO' then 'N'
	   when d.dbid = :myroot then '/'
	   when d.dbid = :mypdbid then 'P'
	   else ' '
      end container
    , nvl(x.scount,0) scount
    , y.instance_list
    from
      (
      select dbid
      from dba_hist_database_instance group by dbid
      ) d
    left join
      (
      select dbid
      , count(*) scount
      from dba_hist_snapshot
      group by dbid
      ) x
    on d.dbid = x.dbid
    left join
      (
      select dbid
      , listagg(instance_number, ',') 
	within group (order by instance_number) instance_list
      from
      (
      select dbid
      , instance_number
      from dba_hist_snapshot
      group by dbid, instance_number
      )
      group by dbid
      ) y
    on d.dbid = y.dbid
    order by dbid
    /
  loop
    printf "%11d  %.1s    %6d %s\n", dbid, container, scount, instance_list;
  end loop;
  exit 0;
end if;

# dbid specified, but not snap interval
if dbid is not null
  and (begin_snap is null or end_snap is null)
then
  printf "directory                      path\n";   
  printf "------------------------------ ----\n";
  for
    select directory_name directory
    , directory_path pathname
    from dba_directories
    /
  loop
    printf "%-30s %s\n", directory, pathname;
  end loop;
  exit 0;
end if;

if begin_snap is null
   or end_snap is null
   or begin_snap < 1
   or end_snap < 1
   or begin_snap >= end_snap
then
  writeline stderr, "Both begin-snap and end-snap must be provided and begin-snap must be less than end-snap\n";
  exit 1;
end if;

if filename = "" then
  sprintf filename, "%d_%d_%d", dbid, begin_snap, end_snap;
end if;

integer filesize, fileexists := 0;

string(1000) filenamedmp := filename ".dmp";

if instrb(filename, ".") or instrb(filename,"/") or instrb(filename, "\\") then
  fprintf stderr, "The name of the dumpfile '%s' should not contain a suffix, / or \\\n", filename;
  exit 1;
end if;

procedure awrexport()
  # first try the newer documented call
  # unless the user does not want it
  if !use_extract then
    sql execute
      begin
	dbms_workload_repository.awr_exp
	( dmpfile  => :filename
	, dmpdir   => :directory
	, bid      => :begin_snap
	, eid      => :end_snap
	, dbid     => :dbid
	);
      end;
      /
      ignoreerror;
    end sql;
  end;
  if use_extract or oraerror = 6550 then
    # if it failed, use the non default call
    begin
      dbms_workload_repository.extract
      ( dmpfile  => :filename
      , dmpdir   => :directory
      , bid      => :begin_snap
      , eid      => :end_snap
      , dbid     => :dbid
      );
    end;
    /
  elseif oraerror then
    writeline stderr, oraerrortext;
  end if;
  if oraerror = 13506 then
    if dbid = myroot then
      fprintf stderr, "Are you attempting exporting root data (dbid=%d) while logged in to a PDB (dbid=%d)?\n", dbid, mypdbid;
    else
      fprintf stderr, "Is dbid=%d available and has the snapshot range %d to %d?\n", dbid, begin_snap, end_snap;
    end if;
  end if;
end awrexport; 

sql get_file_size
  declare
    l_fexists boolean;
    l_file_length number;
    l_block_size binary_integer;
  begin
    utl_file.fgetattr
    ( location => :directory
    , filename => :filenamedmp
    , fexists  => l_fexists
    , file_length => l_file_length
    , block_size => l_block_size
    );
    if l_fexists then
      :fileexists := 1;
      :filesize := l_file_length;
    else
      :fileexists := 0;
    end if;
  end;
  /
  bind :directory, :filenamedmp;
  bindout :fileexists, :filesize;
end;

integer dircnt := 0;
for
  select directory_path pathname
  from dba_directories
  where directory_name = :directory
  /
loop
  dircnt+=1;
end loop;

if !dircnt then
  writeline stderr, "Directory " directory " is not accessible";
  exit 1;
end if;

get_file_size;
commit;
if fileexists and not remove_file then
  printf "Dump file '%s' of size %d (%.2KB) already exists in '%s', use --remove-file to overwrite\n"
  , filenamedmp, filesize, filesize, directory;
  exit 1;
end if;

if remove_file then
  declare
    l_fexists boolean;
    l_file_length number;
    l_block_size binary_integer;
  begin
    utl_file.fgetattr
    ( location => :directory
    , filename => :filenamedmp
    , fexists  => l_fexists
    , file_length => l_file_length
    , block_size => l_block_size
    );
    if l_fexists then
      utl_file.fremove
      ( location => :directory
      , filename => :filenamedmp
      );
    end if;
  end;
  /
end if;

awrexport;
commit;

get_file_size;
commit;

if fileexists then
  printf "Dump file %s of size %d (%.2KB) found in directory %s\n"
  , filenamedmp, filesize, filesize, directory;
else
  fprintf stderr, "Error dumping %s to directory %s\n", filenamedmp, directory;
  exit 1;
end if;

if logfile != "" then
  string(2050) lin;
  string(1000) filenamelog := filename ".log";
  integer status;
  file yt;

  # the log file is a relatively small text file, so using dbms_output
  # one line at a time is perfectly fine
  yt >= logfile;

  declare 
    myfil utl_file.file_type;
    lin varchar2(2050);
  begin
    dbms_output.enable(null);
    myfil := utl_file.fopen(:directory
    , :filenamelog, 'r');
    loop
      utl_file.get_line(myfil,lin);
      dbms_output.put_line(lin);
    end loop;
  exception
    when no_data_found then
      utl_file.fclose(myfil);
  end;
  /
  status := 0;
  while !status loop
    begin
      dbms_output.get_line(:lin,:status);
    end;
    /
    writeline yt,lin;
  end loop;
  commit;
  yt := null;
end if;

