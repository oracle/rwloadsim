# bengsig   3-apr-2025 - Missing file close without --end2end
# bengsig   9-jan-2025 - Add upload
# bengsig   1-dec-2024 - No () after procedure call
# bengsig  28-feb-2024 - Windows port
# bengsig  19-sep-2022 - Simplified and enhanced 
# bengsig  13-sep-2022 - Now netthroughput.rwl
# bengsig  28-apr-2022 - Exit on connect error
# bengsig  18-may-2021 - Improve output
# bengsig  09-sep-2020 - Add help text
# bengsig  20-may-2020 - Creation

# This RWP*Load Simulator script it used to test
# the throughput of an Oracle NET connection
# between a client or application server and a 
# database.
#
# You will need a username, password and connect string
# that allows you to connect to your database. The only
# requirement for the user is that it needs to be able
# to execute queries; no tables or other objects will
# be created.
#
# To peform an initial, simple test, execute
#
# netthroughput -l username/{password}@db --download
#
# To get help, execute
#
# netthroughput --help
#
$alwaysmute:206

# If we didn't connect, don't do anything
$if not defined(default database) $then
  writeline stderr, "Missing or incorrect -l option; use -h to get help";
  exit 1;
$endif

$implicit:both

double period := 60;
integer verbosetest := 0;
integer end2end := 0;
integer concurrency := 1;
integer fetcharray := 8; # do not change
double rampup := 5.0;
integer mbperquery := 1; # do not change
string(2048) csvoutput;
string(2048) csvappend;
integer csvexcel := 0;
integer upload := 0;
integer download := 0;
integer upload_pct;

	      $userhelp:""
              $userhelp:"netthroughput - Measure Oracle Net throughput between database and client."
	      $userhelp:""
              $userhelp:"This utility uses one or more database connections to run queries sending or"
              $userhelp:"receiving large data volumes to allow measuring the possible throughput."
              $userhelp:"You provide a number of concurrent streams doing this and can by increasing"
              $userhelp:"the count get an estimate of the maximum throughput available."
              $userhelp:"If there is access to v$mystat, both physical and logical throughput"
              $userhelp:"will be measured; otherwise only logical is available."
	      $userhelp:"-l u/p@c          : Compulsory option providing database credentials"
     $useroption:period:"--period=N        : Set run period, default is 60s"
$userswitch:verbosetest:"--verbosetest     : Make output more verbose"
$useroption:concurrency:"--concurrency=N   : Run this many concurrent throughput tests, default 1"
     $useroption:rampup:"--rampup=N        : Set rampup period for throughput tests, default is 5s"
     $userswitch:upload:"--upload          : Measure upload performance"
   $userswitch:download:"--download        : Measure download performance"
 $useroption:upload-pct:"--upload-pct=N    : When using both upload and download, by default, every"
              $userhelp:"                    every other will do upload or download. Use --upload-pct"
              $userhelp:"                    with a value different from 50 implies the split between"
              $userhelp:"                    the two will be uneven"
    $userswitch:end2end:"--end2end         : Also gather end-to-end timing"
  $useroption:csvoutput:"--csvoutput=file  : Write pure csv data to this file"
  $useroption:csvappend:"--csvappend=file  : Append pure csv data to this file"
   $userswitch:csvexcel:"--csvexcel        : Use ';' field separator and CRLF line terminator in csv"
              $userhelp:"If you create a csv file, it has at least six columns:"
              $userhelp:"1: the value of concurrency"
              $userhelp:"2: the logical download throughput in MB/s"
              $userhelp:"3: the physical download throughput in MB/s or 0 if not available"
              $userhelp:"4: the logical upload throughput in MB/s"
              $userhelp:"5: the physical upload throughput in MB/s or 0 if not available"
              $userhelp:"6: 0 if data is reliable, otherwise the needed rampup"
	      $userhelp:"With end-to-end timings, six further columns are added with"
	      $userhelp:"download and upload total, oci, and database time"

integer dophys := 1;

$clockstart:0
$if end2end $then
  $statsdbtime:on
  $statsapptime:on
$endif

# Check that we can read v$
integer vdollarval := 0;
sql checkvdollar
  select 42 from
  v$mystat s join v$statname n
  on s.statistic# = n.statistic#
  where n.name = 'bytes sent via SQL*Net to client'
  /
  define 1 vdollarval;
  ignoreerror;
end;

checkvdollar;

if oraerror != 0 or vdollarval != 42 then
  writeline stderr, "No access to v$ tables - only logical throughput measured";
  dophys := 0;
end if;

$oraerror:stop
if !download and !upload then
  writeline stderr, "At least one of --upload or --download must be provided";
  exit 1;
end if;

if concurrency < 1 and not (download and upload) then
  writeline stderr, "Concurrency must be at least 1";
  exit 1;
end if;

if download and upload and (concurrency < 2 or concurrency % 2) then
  writeline stderr, "Concurrency must be even and at least 2";
  exit 1;
end if;

# The download test is based on running a query that generates 
# roughly 1MB of output in 64 rows each having five columns with
# a total of roughly 16kB of data.
# As the overhead in SQL*Net isn't known, we make the rows
# slightly smaller than 16KB, and we make sure each column is
# well below the 4000 character limit of varchar2
# With an array size of 8, there will about about 128k in each array fetch

integer lp := 3240; # Value found experimentally to be fine

# values where the five columns are saved
string(4000) yt0, yt1, yt2, yt3, yt4;

# use the database to create a random string
# with high entropy using any printable character
# It is returned as an actual string literal and if
# quot is true, enclosed in ' to be used in generating
# a SQL statement, otherwise only finishing with a '
# Note that there are no other ' in the string
function ranstr(integer lgt, integer quot) return string(4000)
is
  string(4000) retval;
  select
    translate(dbms_random.string('p',:lgt),'''',' ') retval
  from dual;
  if quot then
    return "'" retval "'";
  else
    return retval "'";
  end if;
end ranstr;

string(100000) genqry; # the download query we will execute

integer i;

genqry := "select \n";
for i := 0 .. 4 loop
  genqry ||= (i ? "," : " " ) ||"to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || ";
  genqry ||= ranstr(lp,1);
  genqry ||= " || to_char(rownum,'FMXXXXXXXX') yt" i "\n";
end loop;
genqry ||= "from dual connect by rownum <= :mbperquery * 64";

# printline genqry;
# The result of this is something like:
#
# select 
#  to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || 'GSODIr[_&.' || to_char(rownum,'FMXXXXXXXX') yt1
# ,to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || '.%aX5Lus[@' || to_char(rownum,'FMXXXXXXXX') yt2
# ,to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || 'a+7Qgw7n`p' || to_char(rownum,'FMXXXXXXXX') yt3
# ,to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || '1[L(}O3nQS' || to_char(rownum,'FMXXXXXXXX') yt4
# ,to_char(rownum*1234577+:loopnumber,'FMXXXXXXXX') || '`x]FO|G.m6' || to_char(rownum,'FMXXXXXXXX') yt5
# from dual connect by rownum < :mbperquery * 64
#
# except each random string really is 3240 characters long. Note that mpperquery is 1.
#
# The to_char stuff returned in hex is to ensure there is no possibility of repeated row values
# that could cause an Oracle network layer optimization. The high entropy also helps ensuring
# the possibility for compression in any layer is low.

# declare it as a dynamic sql
sql selNmb
  array fetcharray; # always 8
end;

double timestart, timestop;

timestart := rampup + runseconds()+0.5*concurrency; # allow time for rampup
timestop := timestart + period ;

# totals for download
double threads sum totaldnmb := 0;
double threads sum totaldnnetmb := 0;
integer threads sum dnthreads := 0;
# totals for upload
double threads sum totalupmb := 0;
double threads sum totalupnetmb := 0;
integer threads sum upthreads := 0;
# totals for end-2-end
double threads sum totuprun := 0;
double threads sum totupoci := 0;
double threads sum totupora := 0;
double threads sum totdnrun := 0;
double threads sum totdnoci := 0;
double threads sum totdnora := 0;
# others
integer threads sum increaseramp := 0;

procedure exec1mqueries()
  # This procedure expects a session to already be taken
  # and runs the actual download 
  integer tot := 0;
  modify sql selNmb for genqry;

  double perqrymb := 0;
  double myrun, myora, myoci;

  # make sure it is parsed
  for count 1 loop # just to make loopnumber have a value
    for selNmb loop
      null;
      # the 87 bytes we add here is experimentally found to be
      # the overhead in shipping the row with the five columns
      perqrymb += (87
	+lengthb(yt0)
	+lengthb(yt1)
	+lengthb(yt2)
	+lengthb(yt3)
	+lengthb(yt4)
	)/1e6 ;
    end loop;
  end loop;
  if verbosetest and (threadnumber = 1 or upload and threadnumber = 2) then
    printf "%.3fMB logical per download query\n", perqrymb;
  end if;

  # verify all will be started at the same time
  if runseconds() > timestart then
    printline "Download thread " threadnumber " starting late at " runseconds() ", expected starttime " timestart;
    increaseramp += 1;
  end if;
  if verbosetest then
    printline "Download thread " threadnumber " connected";
  end if;
    
  if threadnumber = concurrency then
    printline "All threads connected";
  end if;
  myora := dbseconds();
  myoci := ociseconds();
  for start timestart stop timestop loop
    if loopnumber = 1 then
      myrun := runseconds();
    end if;
    if loopnumber = 1 and threadnumber = 1 then
      printline "Throughput test now running " period " s";
    end if;
    # do nothing but running the query
    for selNmb loop
      tot += 1;
    end loop;
    totaldnmb += perqrymb;
  end loop;
  totdnrun += runseconds()-myrun;
  totdnora += dbseconds()-myora;
  totdnoci += ociseconds()-myoci;

  if verbosetest then
    fprintf stderr,"Thread %d completed %d %dM loops in %.1fs returning %.0fMB logical bytes\n"
    , threadnumber, tot, mbperquery, runseconds()-timestart, totaldnmb;
  end if;
  modify sql selNmb release;

end procedure;

procedure start1mqueries()
  # this procedure will get the session
  # and the bytes from v$mystat if possible

  double netmb1, netmb2;
  sql qrybytes
    select s.value/1e6 netmb2 from
    v$mystat s join v$statname n
    on s.statistic# = n.statistic#
    where n.name = 'bytes sent via SQL*Net to client'
    /
  end;

  if dophys then
    qrybytes;
    netmb1 := netmb2;
    exec1mqueries;
    qrybytes;
    if verbosetest then
      fprintf stderr, "Thread %d returned %.0fMB physical bytes\n",threadnumber,  netmb2-netmb1;
    end if;
    totaldnnetmb += netmb2-netmb1;
  else
    exec1mqueries;
  end if;
  dnthreads += 1;
end procedure;

# Implementation of upload
# Upload is tested by executing a single query that uses a total
# of 25 bind variables each slightly smaller than 4000 bytes
# such that their total length is about 100kB

# Acutal bytes per bind variable
integer lpup := 3989; # Found experimentally
string(4000) up01, up02, up03, up04, up05;
string(4000) up06, up07, up08, up09, up10;
string(4000) up11, up12, up13, up14, up15;
string(4000) up16, up17, up18, up19, up20;
string(4000) up21, up22, up23, up24, up25;
# Fill all 32 with random text strings ensuring high entropy
up01 := ranstr(lpup,0); up02 := ranstr(lpup,0); up03 := ranstr(lpup,0); up04 := ranstr(lpup,0);
up05 := ranstr(lpup,0); up06 := ranstr(lpup,0); up07 := ranstr(lpup,0); up08 := ranstr(lpup,0);
up09 := ranstr(lpup,0); up10 := ranstr(lpup,0); up11 := ranstr(lpup,0); up12 := ranstr(lpup,0);
up13 := ranstr(lpup,0); up14 := ranstr(lpup,0); up15 := ranstr(lpup,0); up16 := ranstr(lpup,0);
up17 := ranstr(lpup,0); up18 := ranstr(lpup,0); up19 := ranstr(lpup,0); up20 := ranstr(lpup,0);
up21 := ranstr(lpup,0); up22 := ranstr(lpup,0); up23 := ranstr(lpup,0); up24 := ranstr(lpup,0);
up25 := ranstr(lpup,0);
double outtotb;

# SQL that will upload about 100k (32 * 4k) to the database
# note that the instrb searching for a ' is guaranteed to scan
# the whole string as we know it only has a ' at the end.
sql upl100k
  select /*+no_result_cache*/
     instrb(:up01,'''')+instrb(:up02,'''')+instrb(:up03,'''')+instrb(:up04,'''')+instrb(:up05,'''')
    +instrb(:up06,'''')+instrb(:up07,'''')+instrb(:up08,'''')+instrb(:up09,'''')+instrb(:up10,'''')
    +instrb(:up11,'''')+instrb(:up12,'''')+instrb(:up13,'''')+instrb(:up14,'''')+instrb(:up15,'''')
    +instrb(:up16,'''')+instrb(:up17,'''')+instrb(:up18,'''')+instrb(:up19,'''')+instrb(:up20,'''')
    +instrb(:up21,'''')+instrb(:up22,'''')+instrb(:up23,'''')+instrb(:up24,'''')+instrb(:up25,'''')
    outtotb
  from dual;
end upl100k;

procedure exec100kuploads()
  # This procedure expects a session to already be taken
  # and does the real upload

  integer tot;
  double peruplmb := 0.100;
  double myrun, myora, myoci;

  # make sure it is parsed
  upl100k;
  if verbosetest and threadnumber = 1 then
    printf "%.3fMB/%.3fMB logical per upload\n", peruplmb, outtotb/1e6;
  end if;

  # Verify all are concurrent
  if runseconds() > timestart then
    printline "Upload thread " threadnumber " starting late at " runseconds() ", expected starttime " timestart;
    increaseramp += 1;
  end if;
  if verbosetest then
    printline "Upload thread " threadnumber " connected";
  end if;
    
  if threadnumber = concurrency then
    printline "All threads connected";
  end if;
  myora := dbseconds();
  myoci := ociseconds();
  for start timestart stop timestop loop
    if loopnumber = 1 then
      myrun := runseconds();
    end if;
    if loopnumber = 1 and threadnumber = 1 then
      printline "Throughput test now running " period " s";
    end if;
    upl100k;
    tot += 1;
    totalupmb += peruplmb;
  end loop;
  totuprun += runseconds()-myrun;
  totupora += dbseconds()-myora;
  totupoci += ociseconds()-myoci;

  if verbosetest then
    fprintf stderr,"Upload thread %d completed %d queries in %.1fs returning %.0fMB logical bytes\n"
    , threadnumber, tot, runseconds()-timestart, totalupmb;
  end if;

end procedure;

procedure start100kuploads()
  # this procedure will get the session
  # and the bytes from v$mystat if possible

  double upnetmb1, upnetmb2;
  sql uplbytes
    select s.value/1e6 upnetmb2 from
    v$mystat s join v$statname n
    on s.statistic# = n.statistic#
    where n.name = 'bytes received via SQL*Net from client'
    /
  end;

  if dophys then
    uplbytes;
    upnetmb1 := upnetmb2;
    exec100kuploads;
    uplbytes;
    if verbosetest then
      fprintf stderr, "Thread %d uploaded %.0fMB physical bytes\n",threadnumber,  upnetmb2-upnetmb1;
    end if;
    totalupnetmb += upnetmb2-upnetmb1;
  else
    exec100kuploads;
  end if;
  upthreads += 1;
end procedure;

printline "Connecting sessions";

run
  threads concurrency
    # delay each start to allow connect
    wait 0.5*threadnumber;
    if upload and download then
      # want both, start either
      if $if upload_pct is null $then
           threadnumber % 2
	 $else
	   100 * threadnumber <= upload_pct * concurrency
	 $endif
        then
	  start100kuploads;
	else
	  start1mqueries;
	end if;
    # only one of them wanted:
    elseif upload then
      start100kuploads;
    else
      start1mqueries;
    end if;
  end threads;
end run;

file csvfile;
string csvformat;
integer docsv := 0;
integer doheader := 0;

# Add the CR when asking for Windows on Linux
string extracr;
$if not $windows $then
  extracr := "\r";
$endif

# write or append to csv file
if csvappend != "" then
  if not access(csvappend, "fr") then
    doheader := 1;
  end if;
  csvfile >>= csvappend;
  docsv := 1;
else
  if csvoutput != "" then
    csvfile >= csvoutput;
    docsv := 1;
    doheader := 1;
  end if;
end if;

if docsv then
  if doheader then
    # write appropiate header
    if csvexcel then
      writeline csvfile,"streams;logicalMBdownload/s;physicalMBdownload/s;logicalMBupload/s;physicalMBupload/s;rampupneed"
        || (end2end ? ";dnrun;dnoci;dnora;uprun;upoci;upora" : "") || extracr ;
    else
      writeline csvfile,"#streams logicalMBdownload/s physicalMBdownload/s logicalMBupload/s physicalMBupload/s rampupneed"
        || (end2end ? " dnrun dnoci dnora uprun upoci upora" : "");
    end if;
  end if;
  # use appropriate printf format depending on conditions
  if end2end then
    if csvexcel then
      csvformat := "%d;%.3f;%.3f;%.3f;%.3f;%.0f;%.1f;%.1f;%.1f;%.1f;%.1f;%.1f" extracr "\n";
    else
      csvformat := "%d %.3f %.3f %.3f %.3f %.0f %.1f %.1f %.1f %.1f %.1f %.1f\n";
    end if;
  else
    if csvexcel then
      csvformat := "%d;%.3f;%.3f;%.3f;%.3f;%.0f" extracr "\n";
    else
      csvformat := "%d %.3f %.3f %.3f %.3f %.0f\n";
    end if;
  end if;
end if; 

# tell user if some were late and suggest --rampup value
if increaseramp then
  if dophys then
    if download then
      printf "Unreliable download throughput estimate %.2MB/s logical, %.2MB/s physical\n"
      , 1e6*totaldnmb/period, 1e6*totaldnnetmb/period;
    end if;
    if upload then
      printf "Unreliable upload throughput estimate %.2MB/s logical, %.2MB/s physical\n"
      , 1e6*totalupmb/period, 1e6*totalupnetmb/period;
    end if;
  else
    if download then
      printf "Unreliable download throughput estimate %.2MB/s logical\n"
      , 1e6*totaldnmb/period;
    end if;
    if upload then
      printf "Unreliable upload throughput estimate %.2MB/s logical\n"
      , 1e6*totalupmb/period;
    end if;
  end if;
  printline "Rerun with --rampup=" rampup+increaseramp " or higher to ensure all threads are executing concurrently";
  if docsv then
    fprintf csvfile, csvformat, concurrency, totaldnmb/period, totaldnnetmb/period
    , totalupmb/period, totalupnetmb/period, rampup+increaseramp
    $if end2end $then , totdnrun, totdnoci, totdnora, totuprun, totupoci, totupora $endif ;
  end if;
else
  # write normal human readable output
  if dophys then
    if download then
      printf "Download throughput estimate %.2MB/s logical, %.2MB/s physical\n"
      , 1e6*totaldnmb/period, 1e6*totaldnnetmb/period;
    end if;
    if upload then
      printf "Upload throughput estimate %.2MB/s logical, %.2MB/s physical\n"
      , 1e6*totalupmb/period, 1e6*totalupnetmb/period;
    end if;
  else
    if download then
      printf "Download throughput estimate %.2MB/s logical\n"
      , 1e6*totaldnmb/period;
    end if;
    if upload then
      printf "Upload throughput estimate %.2MB/s logical\n"
      , 1e6*totalupmb/period;
    end if;
  end if;
  if docsv then
    fprintf csvfile, csvformat, concurrency, totaldnmb/period, totaldnnetmb/period, totalupmb/period, totalupnetmb/period, 0
    $if end2end $then , totdnrun, totdnoci, totdnora, totuprun, totupoci, totupora $endif ;
  end if;
end if;
if end2end then
  # write end-2-end as human readable output
  if download then
    printf "Download %d streams total time: run %.3f, oci %.3f, net %.3f, db %.3f\n"
      , dnthreads, totdnrun, totdnoci, totdnoci-totdnora, totdnora;
  end if;
  if upload then
    printf "Upload %d streams total time: run %.3f, oci %.3f, net %.3f, db %.3f\n"
      , upthreads, totuprun, totupoci, totupoci-totupora, totupora;
  end if;
else
  # or just stream counts
  printf "%d download streams and %d upload streams\n", dnthreads, upthreads;
end if;
  
if docsv then
  csvfile := null;
end if;
