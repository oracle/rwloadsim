# test write of raw data to files
# uses the tet413 table generated by 413.rwl

$include:"testuserinfo.rwl"
$include:"testdefault.rwl"

raw raw1;
string str1;

raw file fil;

integer i;

# get some raw data
select utl_raw.cast_to_raw('Hello') raw1
from dual;
sql execute
  begin /*one*/
    :str1 := :raw1;
  end;
  /
bindout :str1;
end;

# open file for writing
fil >= "414.bin";

write fil, raw1;

# get some more include zero byte
sql execute
  begin
    :raw1 := '05002737471112a9fe';
  end;
  /
  bindout :raw1;
end;

# write, flush, show
write fil, raw1;
fflush fil;
system "hexdump -C 414.bin";

# write more, flush, show
write fil, raw1;
fflush fil;
system "hexdump -C 414.bin";

# make sure we can use a procedure
for i := 10 .. 22 loop
  sql execute
    begin
      :raw1 := 'deadbeef0badf00d' || to_char(:i,'FM99');
    end;
    /
    bindout :raw1;
  end;

  write fil, raw1;
end;

# close file and show
fil := null;
system "hexdump -C 414.bin";

# make sure variables inside procedure work
# as expected and test open append
execute
  integer jjj;
  raw raw2;
  raw file fil2;
  fil2 >>= "414.bin";
  for jjj := 30 .. 66 loop
    sql execute
      begin
	:raw2 := 'abcd' || to_char(:jjj,'FM99');
      end;
      /
      bindout :raw2;
    end;

    write fil2, raw2;
  end;
  fil2 := null;
end;

# finally read the data from 413.rwl and append it
fil >>= "414.bin";
for
  select a raw1 from test413 order by rno
  /
loop
  write fil, raw1;
end loop;
fil := null;

system "hexdump -C 414.bin";

raw(42) raw3;
raw file fil3, fil4;

fil3 <= "414.bin";
fil4 >= "414.two";

i := 0;
for read fil3,raw3 loop
  write fil4,raw3;
  printline i;
  i += 1;
end loop;

fil3 := null;
fil4 := null;

system "md5sum 414.bin 414.two";
system "wc -c 414.bin 414.two";

fil3 <= "414.bin";
fil4 >>= "414.two";

i := 0;
for read fil3,raw3 and i<4 loop
  write fil4,raw3;
  printline i;
  i += 1;
end loop;

fil3 := null;
fil4 := null;

system "wc -c 414.bin 414.two";

raw(10000) raw4;

fil3 <= "414.bin";
fil4 >= "414.two";

read fil3,raw4;
write fil4,raw4;
fil3 := null;
fil4 := null;
system "md5sum 414.bin 414.two";
system "wc -c 414.bin 414.two";

system "rm -f 414.bin 414.two";

fil <|= "echo hello";

raw file cannotassign >= "/dev/null";
