# look for possible race conditions with COW code

string str;
integer int;

int := 0;
str := "Hello, World!";

$startseconds:2

run
  threads 20
    string lstr;
    int := threadnumber;
    sprintf str, "Here is thread %d", threadnumber;
    for start 2 count 1 loop
      if int != threadnumber then
        printf "bad int %d %d\n", int, threadnumber;
      end if;
      sprintf lstr, "Here is thread %d", threadnumber;
      if str != lstr then
        printf "bad str %s %s\n", str, lstr;
      end if;
    end loop;
  end threads;
end;

if int != 0 then
  printf "bad main int %d\n", int;
end if;
if str != "Hello, World!" then
  printf "bad main str %s\n", str;
end if;
