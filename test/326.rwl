integer threads sum i; # check threads sum variables
double threads sum a := 100;
integer x := 1;

procedure addsome()
  a := a + 1.5;
  i := i + x;
end;

procedure addtwo()
  a := a + 2.0;
end;

procedure withrun3(string w3)
  printline "before run", w3;
  run
    threads 1
      for count 1 loop
        printline "inside run", w3;
      end loop;
    end threads;
  end run;
end withrun3;

function withrun2()
return integer 
is
  run
    threads 2
      for count 2*x loop addsome(); end;
    end;
  end;
  return x;
end;

procedure withrun()
  withrun3("outside");
  run
    threads 4 
      for count 10 loop addsome(); end;
      for count 2 loop  addtwo(); end;
    end;
    threads 2
      withrun3("inside");
      for count 5 loop addsome(); end;
    end;
  end;
end;

if 1 then
  withrun();
end if;

printline "a=", a, ", i=", i;

x := 5;

printf "%d\n", withrun2();

printline "a="|| a, ", i="|| i;
